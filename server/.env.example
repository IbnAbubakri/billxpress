# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Supabase)
# Format: postgresql://user:password@host:port/database
# For local dev, use the Supabase connection string from your project dashboard
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase region (used for pooler URL rewrite)
SUPABASE_REGION=eu-west-1

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (for sending emails)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@billxpress.com

# SMS Provider (for OTP sending)
# When set, OTP codes are sent via SMS instead of displayed in UI
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# Demo mode: if SMS_PROVIDER is not set, OTP codes are shown in the UI
# and emails are auto-verified for development/demo purposes.
